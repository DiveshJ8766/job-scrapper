# FresherJobs AI - environment variables
# Copy to .env (git-ignored) for local use. In production set the same names in:
#   - Vercel project settings  (web app: DATABASE_URL, ADMIN_REFRESH_TOKEN, GITHUB_*)
#   - GitHub repo Settings > Secrets and variables > Actions  (pipeline: DATABASE_URL, ADZUNA_*, GEMINI_API_KEY / OPENAI_API_KEY)
# Never prefix any of these with NEXT_PUBLIC_ - none of them may reach the browser.

# --- Database (Postgres; Neon via the Vercel Marketplace works well) -------------
# Use the POOLED connection string for Vercel; either works for the pipeline.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Job sources ------------------------------------------------------------------
# Free key: https://developer.adzuna.com  (if blank, Adzuna is skipped)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- LLM classification ------------------------------------------------------------
# gemini (default) or openai
LLM_PROVIDER=gemini
# Defaults: gemini-2.5-flash-lite for gemini, gpt-4o-mini for openai
LLM_MODEL=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://platform.openai.com/api-keys (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Requests per minute cap (free Gemini tier is rate limited; raise on a paid tier)
LLM_MAX_RPM=12
# Max jobs classified per pipeline run (the rest wait for the next run)
LLM_MAX_JOBS_PER_RUN=900
LLM_TEMPERATURE=0
# Optional price override in USD per 1M tokens, if your model is not in pipeline/classify/pricing.py
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=

# --- Admin manual refresh (web app) -------------------------------------------------
# Long random string; you type it on /admin to start a refresh. e.g. `openssl rand -hex 32`
ADMIN_REFRESH_TOKEN=
# Fine-grained GitHub token with "Actions: Read and write" on this repo only
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=DiveshJ8766/job-scrapper
GITHUB_WORKFLOW_FILE=daily-refresh.yml
GITHUB_REF_NAME=main

# --- Tests (optional) -----------------------------------------------------------------
# A throwaway database; the Python tests DROP and recreate tables in it.
TEST_DATABASE_URL=
